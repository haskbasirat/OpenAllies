# --- Build output ---------------------------------------------------------
target/
**/target/
*.pdb

# --- Local-only folders ----------------------------------------------------
# Packaged releases and backups bundle files from the original game.
/release/
/backups/
# QA captures: screenshots of the original game, logs, run output.
/qa-output/
# Caches generated from the player's own installed copy of the game.
/assets-cache/

# --- Data taken from the original game never goes in the repository --------
# Recorded results of running the original code (oracle fixtures) are
# regenerated locally by the research scripts from your own AA.exe.
crates/**/tests/fixtures/
crates/aa-client/src/vfx/textures/
crates/aa-client/src/vfx/nif_effects.json

# Research: keep scripts and notes; everything else is local data.
/research/**
!/research/**/
!/research/**/*.py
!/research/**/*.ps1
!/research/**/*.md
!/research/**/*.txt
!/research/**/*.rs
!/research/**/Cargo.toml
!/research/**/findings.json
!/research/**/inventory.json
# ...except disassembly listings, logs and copied third-party or snapshot code.
/research/**/*asm*.txt
/research/**/*disasm*.txt
/research/**/*.log
/research/**/checkpoint*-sources/
/research/byroredux-*/corpus/

# --- Editor / OS noise --------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
__pycache__/
*.pyc

